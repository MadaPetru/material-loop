{
  "expo": {
    "name": "MaterialLoop",
    "slug": "materialloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "materialloop",
    "userInterfaceStyle": "light",
    "primaryColor": "#2F5D3A",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.materialloop.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSPhotoLibraryUsageDescription": "MaterialLoop uses your photo library so you can add images to listings.",
        "NSCameraUsageDescription": "MaterialLoop uses the camera so you can take photos for listings.",
        "NSLocationWhenInUseUsageDescription": "MaterialLoop uses your location to show materials near you.",
        "CFBundleLocalizations": [
          "en",
          "ro"
        ]
      }
    },
    "android": {
      "package": "ro.materialloop.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2F5D3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": false,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "materialloop"
            }
          ]
        }
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=ro.materialloop.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EDE9E2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MaterialLoop uses your photos for listing images. / MaterialLoop folosește fotografiile pentru anunțurile tale.",
          "cameraPermission": "MaterialLoop uses the camera to take photos for listings. / MaterialLoop folosește camera pentru poze la anunțuri."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MaterialLoop uses your location to find materials near you. / MaterialLoop folosește locația pentru a găsi materiale în apropiere.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ro"
            ],
            "android": [
              "en",
              "ro"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://materialloop.website/legal/privacy",
      "termsOfServiceUrl": "https://materialloop.website/legal/terms",
      "supportEmail": "mada.petru@digitalexplorer.ro",
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "b1caaa3a-1c44-45e6-bd2f-1de4d053bb4e"
      }
    },
    "owner": "mada-petru"
  }
}
