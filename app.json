{
  "expo": {
    "name": "MaterialLoop",
    "slug": "materialloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "materialloop",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.materialloop.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F5D3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "ro.materialloop.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EDE9E2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MaterialLoop folosește fotografiile pentru anunțurile tale."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MaterialLoop folosește locația pentru a găsi materiale în apropiere."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "ro"],
            "android": ["en", "ro"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-when-eas-configured"
      }
    }
  }
}
