# Copy to .env and fill when you create a Supabase project.
# Without these, the app runs in local demo mode.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Google OAuth is configured in the Supabase dashboard (not in this file).
# See README → "Google Sign-In" for Client ID/Secret + Redirect URLs.
# App redirectTo: web = {origin}/login · native = materialloop://login
